{
  "name": "ai-secretary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "npx tsx scripts/migrate-json-to-db.ts",
    "cf:build": "next build && npx vercel build && npx @cloudflare/next-on-pages",
    "cf:deploy": "npm run cf:build && npx wrangler pages deploy",
    "cf:db:create": "npx wrangler d1 create ai-secretary-db",
    "cf:db:migrate": "npx wrangler d1 execute ai-secretary-db --file=./migrations/001_initial.sql"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "jose": "^6.2.4",
    "next": "^15.3.0",
    "openai": "^6.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.0.0",
    "sharp": "^0.35.3",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vercel": "^47.0.4",
    "wrangler": "^3.114.17"
  }
}
