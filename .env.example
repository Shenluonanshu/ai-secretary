# 知行 AI 秘书 — 环境变量模板
# 复制此文件为 .env.local 并填入你的配置

# 认证
AUTH_PASSPHRASE=your-password-here
JWT_SECRET=openssl-rand-hex-32-result

# LLM 提供者 (cf-ai | openai | rule-based)
LLM_PROVIDER=cf-ai

# 仅 LLM_PROVIDER=openai 时需要以下配置
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 语音提供者 (web-speech | whisper)
SPEECH_PROVIDER=web-speech
